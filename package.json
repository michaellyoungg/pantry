{
  "name": "pantry",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "bash scripts/integration.sh",
    "test:e2e": "bash scripts/e2e.sh",
    "lint": "oxlint && oxfmt --check && turbo run lint",
    "format": "oxfmt && oxlint --fix",
    "knip": "pnpm --filter @pantry/web exec tsr generate && knip",
    "backlog:index": "node scripts/backlog-index.mjs",
    "backlog:index:check": "node scripts/backlog-index.mjs --check",
    "contract:codegen": "node scripts/contract-codegen.mjs",
    "contract:check": "node scripts/contract-codegen.mjs --check",
    "check": "pnpm lint && pnpm contract:check && pnpm typecheck && pnpm lint:types && pnpm test",
    "lint:types": "turbo run build && oxlint --type-aware"
  },
  "devDependencies": {
    "knip": "^6.32.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
