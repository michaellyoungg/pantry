{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/.claude/**",
    "**/_generated/**",
    "**/*.generated.ts",
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/public/**",
    "**/*.css",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/routeTree.gen.ts"
  ]
}
