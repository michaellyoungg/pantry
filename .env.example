# Copy to .env (gitignored) and fill in real values.

# Convex self-hosted backend secret — generate with: openssl rand -hex 32
CONVEX_INSTANCE_SECRET=

# Shared secret proving a caller is Convex when it reaches recipe-service.
# Generate with: openssl rand -hex 32. MUST match the value set on the Convex
# deployment via `convex env set RECIPE_SERVICE_SECRET ...`.
RECIPE_SERVICE_SECRET=

# Observability (BL-0027). Set this and run `docker compose --profile obs up`
# to send traces to the local Grafana stack. Leave unset for a quiet stack.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
