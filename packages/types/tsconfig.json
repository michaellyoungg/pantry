{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // The codegen test drives a root script; it is not part of the published
  // types, so it stays out of `dist` exactly as packages/core does.
  "exclude": ["src/**/*.test.ts"]
}
