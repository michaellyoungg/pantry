{
  // The DOM-free guard. tsconfig.json already sets lib: ES2022 with no ambient
  // @types, but src/convex and src/data pull in the Convex client's
  // declarations, which `/// <reference lib="dom" />` — so DOM globals silently
  // reappear in the whole program. Typechecking the pure + react layers without
  // those subtrees restores the guarantee: a stray `document`/`window` there is
  // a compile error.
  // src/convex and src/data keep their DOM types (they are the Convex client
  // contract) and are held to the same rule by biome.json's noRestrictedGlobals
  // override instead.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true },
  "include": ["src"],
  "exclude": ["src/convex/**", "src/data/**", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
