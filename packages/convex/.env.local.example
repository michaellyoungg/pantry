# Copy to .env.local and fill in the admin key from Step 4.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Convex Auth (BL-0004) — set on the deployment via `convex env set`:
#   SITE_URL=http://localhost:5173
#   JWT_PRIVATE_KEY=...   (generated, see the auth plan Task 1)
#   JWKS=...              (generated)
# Shared secret proving a caller is Convex when it proxies to recipe-service:
#   RECIPE_SERVICE_SECRET=...   (openssl rand -hex 32; MUST match the Go service)
