{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gofmt"],
  "workspaces": {
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}", "e2e/**/*.ts"]
    },
    "apps/recipe-service": {
      "ignoreBinaries": ["go"]
    },
    "packages/convex": {
      "ignoreBinaries": ["go"]
    },
    "apps/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "metro.config.js",
        "metro.workspace-source.js",
        "scripts/*.mjs"
      ],
      "metro": false,
      "ignoreDependencies": ["expo-updates", "react-native-css-interop"]
    }
  }
}
