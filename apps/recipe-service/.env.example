PORT=8090
DATABASE_URL=postgres://pantry:pantry@postgres:5432/pantry?sslmode=disable
# Optional. When set, enables the Claude fallback for URL import of pages
# without schema.org Recipe JSON-LD. Unset = JSON-LD-only import.
ANTHROPIC_API_KEY=
# Optional, and unset is the default. Names the real-store price provider
# (BL-0046); "kroger" is the only value today. Unset = every grocery list is
# priced from the checked-in BLS averages, exactly as before.
PRICING_STORE_PROVIDER=
# Required only when PRICING_STORE_PROVIDER is set. Free from
# https://developer.kroger.com. Without both, real store prices stay disabled
# and the averages stand — a missing key costs the upgrade, never the estimate.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
