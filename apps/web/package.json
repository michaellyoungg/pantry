{
  "name": "@pantry/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "test": "node scripts/generate-theme-css.mjs --check && vitest run",
    "test:coverage": "node scripts/generate-theme-css.mjs --check && vitest run --coverage",
    "test:e2e": "playwright test",
    "tokens:css": "node scripts/generate-theme-css.mjs"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@pantry/convex": "workspace:^",
    "@pantry/core": "workspace:^",
    "@pantry/design-tokens": "workspace:^",
    "@pantry/types": "workspace:^",
    "@tanstack/react-router": "^1.170.35",
    "convex": "^1.45.0",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-cli": "^1.167.35",
    "@tanstack/router-plugin": "^1.168.37",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
