{
  "name": "@pantry/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "test": "node scripts/generate-theme-css.mjs --check && vitest run",
    "test:coverage": "node scripts/generate-theme-css.mjs --check && vitest run --coverage",
    "test:e2e": "playwright test",
    "tokens:css": "node scripts/generate-theme-css.mjs"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.96",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@pantry/convex": "workspace:^",
    "@pantry/core": "workspace:^",
    "@pantry/design-tokens": "workspace:^",
    "@pantry/types": "workspace:^",
    "@tanstack/react-router": "^1.170.46",
    "convex": "^1.49.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
